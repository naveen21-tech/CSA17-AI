# Feed Forward Neural Network

import numpy as np
from sklearn.neural_network import MLPClassifier

# Input data
# [Input1, Input2]
X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])

# Output data - AND operation
y = np.array([0, 0, 0, 1])

# Create Feed Forward Neural Network
model = MLPClassifier(
    hidden_layer_sizes=(4,),
    activation='relu',
    solver='lbfgs',
    max_iter=1000,
    random_state=1
)

# Train the network
model.fit(X, y)

# Test the network
print("Feed Forward Neural Network Output:")

for data in X:
    prediction = model.predict([data])
    print(data, "->", prediction[0])
